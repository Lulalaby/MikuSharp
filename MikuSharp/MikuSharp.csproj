<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<StartupObject>MikuSharp.Program</StartupObject>
		<ApplicationIcon>miku.ico</ApplicationIcon>
		<Version>6.0.0</Version>
		<Authors>aiko, MikuSharp Team</Authors>
		<RepositoryUrl>https://github.com/Sekoree/MikuSharp/</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/Sekoree/MikuSharp/</PackageProjectUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Description>The One And Only Hatsune Miku Bot!</Description>
		<Nullable>enable</Nullable>
		<Title>Hatsune Miku Discord Bot</Title>
		<Copyright>MikuSharp Team</Copyright>
		<PackageIcon>miku.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>discord bot; discatsharp; hatsune miku; miku; bot</PackageTags>
		<NuGetAuditSuppress>true</NuGetAuditSuppress>
		<NuGetAudit>false</NuGetAudit>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<NoWarn>1701;1702;DV2001;CS8603;CS8604;CS8618;CS8601;CS8602;CS8600;CS8625;CA1873</NoWarn>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<NoWarn>1701;1702;DV2001;CS8603;CS8604;CS8618;CS8601;CS8602;CS8600;CS8625</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<None Remove="nnd.python" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)'=='DebugSrc'">
